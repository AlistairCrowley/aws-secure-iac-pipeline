# Terraform's downloaded plugins (large, can be re-downloaded)
.terraform/

# Personal VS Code editor settings
.vscode/


# State files: Terraform's record of what it built. Can contain secrets. 
*.tfstate
*.tfstate.*

# Saved plans can contain sensitive values
*.tfplan

# Variable files can contain passwords or keys
*.tfvars

# Terraform crash logs
crash.log
crash.*.log

# JSON-format variable files can hold secrets too
*.tfvars.json